rceptually-uniform default\nplt.rcParams[\"image.cmap\"] = \"viridis\"\n\n# Example data\nx = np.linspace(-3, 3, 400)\ny = np.linspace(-3, 3, 400)\nX, Y = np.meshgrid(x, y)\nZ = np.hypot(X, Y)\n\n# Sequential (distance field)\nplt.imshow(Z, origin=\"lower\", cmap=cmocean.cm.thermal)\nplt.colorbar(label=\"Temperature-like quantity\")\nplt.title(\"Sequential, perceptually-uniform\")\nplt.show()\n\n# Diverging (positive/negative anomaly)\nZ_anom = np.sin(X) * np.cos(Y)\nplt.imshow(Z_anom, origin=\"lower\", cmap=cmocean.cm.balance, vmin=-1, vmax=1)\nplt.colorbar(label=\"Anomaly\")\nplt.title(\"Diverging around 0\")\nplt.show()\n\n# Cyclic (phase)\nZ_phase = np.angle(np.exp(1j*(X)))\nplt.imshow(Z_phase, origin=\"lower\", cmap=cmocean.cm.phase)\nplt.colorbar(label=\"Phase [rad]\")\nplt.title(\"Cyclic for wrap-around variables\")\nplt.show()","position":{"start":{"line":43,"column":1},"end":{"line":76,"column":1}},"key":"q6dJExMvL4"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"More cmocean info: ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"eNAKDUPmJy"},{"type":"link","url":"https://matplotlib.org/cmocean/","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"matplotlib​.org​/cmocean","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"tZoeCXObXq"}],"urlSource":"https://matplotlib.org/cmocean/","key":"Ag7XQEIkrd"}],"key":"hN4oF7kvQl"},{"type":"heading","depth":3,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Fabio Crameri’s cm tools","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"wbVXIfro5Z"}],"identifier":"fabio-crameris-cm-tools","label":"Fabio Crameri’s cm tools","html_id":"fabio-crameris-cm-tools","implicit":true,"key":"vmObbAr0Xg"},{"type":"paragraph","position":{"start":{"
)\n\n# Diverging (positive/negative anomaly)\nZ_anom = np.sin(X) * np.cos(Y)\nplt.imshow(Z_anom, origin=\"lower\", cmap=cmocean.cm.balance, vmin=-1, vmax=1)\nplt.colorbar(label=\"Anomaly\")\nplt.title(\"Diverging around 0\")\nplt.show()\n\n# Cyclic (phase)\nZ_phase = np.angle(np.exp(1j*(X)))\nplt.imshow(Z_phase, origin=\"lower\", cmap=cmocean.cm.phase)\nplt.colorbar(label=\"Phase [rad]\")\nplt.title(\"Cyclic for wrap-around variables\")\nplt.show()","position":{"start":{"line":43,"column":1},"end":{"line":76,"column":1}},"key":"c5PLE4d0f2"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"More cmocean info: ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"HyIPt0HoBb"},{"type":"link","url":"https://matplotlib.org/cmocean/","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"matplotlib​.org​/cmocean","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"URFCdiNi7B"}],"urlSource":"https://matplotlib.org/cmocean/","key":"eOMSZmTqSG"}],"key":"UHodjh8qYY"},{"type":"heading","depth":3,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Fabio Crameri’s cm Tools","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"M8aGQ1ith1"}],"identifier":"fabio-crameris-cm-tools","label":"Fabio Crameri’s cm Tools","html_id":"fabio-crameris-cm-tools","implicit":true,"key":"dBHRoQG8wq"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"link","url":"https://www.fabiocrameri.ch","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Fabio Crameri","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"U29SutSeAH"}],"urlSource":"https://www.fabiocrameri.ch","key":"VXEBuVKBJg"},
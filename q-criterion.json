start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"NRnEZdVMHH"}],"key":"EgebKFGTop"}],"key":"vJ8QgDJQye"},{"type":"code","lang":"bash","value":"pip install pyvista numpy","position":{"start":{"line":13,"column":1},"end":{"line":15,"column":1}},"key":"LKbjCqkMON"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"(You can skip if those packages are already available.)","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"HIvuc0W2ul"}],"key":"LfLl0AgC2m"}],"key":"rQH3bfcVXR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# If this is a brand‑new environment, uncomment the next line\n# !pip install pyvista numpy\n\nimport numpy as np\nimport pyvista as pv\n","key":"ujENsVCewu"},{"type":"outputs","id":"eXOGJaTv6KD_owUjQLbvO","children":[],"key":"agK67uHHwC"}],"key":"ION2Vrz5FR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# ---------- user parameters ----------\nfilename       = 'my_case.vtp'  # path to your VTK/VTP file\nvelocity_name  = 'U'            # name of the velocity vector array\niso_level      = None           # None ➜ 1×RMS(Q); or specify a positive value\n# --------------------------------------\n","key":"WKgGd7bZj5"},{"type":"outputs","id":"BtQoydJzBtJRmljk0qKTR","children":[],"key":"f4ZnNRHFyM"}],"key":"KwKvIBiqKo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mesh = pv.read(filename)\n\nif velocity_name not in mesh.point_data:\n    raise KeyError(f\"'{velocity_name}' not found in point data. \"\n                   f\"Available arrays: {list(mesh.point_data.keys())}\")\n\nprint(f\"Loaded mesh with {mesh.n_points:,} points and {mesh.n_cells:,} cells\")\n","key":"bfuco1tZg3"},{"type":"outputs","id":"e9q9Om3BrCJJSkf7vIS7E","children":[],"key":"AgOvg7h02Q"}],"key":"sAucqjmVk2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Compute velocity gradient (uses vtkGradientFilter under the hood)\ngrad = mesh.compute_derivative(scalars=velocity_name, gradient=True)\nG    = grad.point_data[f'{velocity_name}_gradient'].reshape(-1, 3, 3)  # (N,3,3)\n\n# Symmetric (strain) and anti‑symmetric (rotation) parts\nS      = 0.5 * (G + np.transpose(G, (0, 2, 1)))\nOmega  = 0.5 * (G - np.transpose(G, (0, 2, 1)))\n\n# Q‑criterion: 0.5*(|Omega|^2 – |S|^2)\nQ = 0.5 * (np.sum(Omega**2, axis=(1, 2)) - np.sum(S**2, axis=(1, 2)))\n\nmesh.point_data['Q'] = Q\nprint(\"Added 'Q' array to point data\")\n","key":"URRMXSFxVI"},{"type":"outputs","id":"8Gp_OJfN_SMF80X3mSzdK","children":[],"key":"VGRJxzIblh"}],"key":"BMcTp2Lyr7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"if iso_level is None:\n    iso_level = np.sqrt(np.mean(Q**2))  # 1×RMS\n    print(f\"Using iso‑level = {iso_level:.3e} (RMS(Q))\")\nelse:\n    print(f\"Using user‑defined iso‑level = {iso_level}\")\n","key":"brKYd9OleR"},{"type":"outputs","id":"1LKk59oOuXzkiBBKxKYgZ","children":[],"key":"IYHfrOgsPy"}],"key":"PHBK2ia2W6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Precompute min/max slider range\nslider_min = 0.1 * iso_level\nslider_max = 5.0 * iso_level\n\n# Helper for live updates\ndef update_threshold(value):\n    plotter.clear()\n    cont = mesh.contour(isosurfaces=[value], scalars='Q')\n    plotter.add_mesh(cont, scalars='Q')\n    plotter.add_axes()\n    plotter.show_grid()\n    plotter.add_text(f'Q = {value:.2e}', position='upper_left')\n    plotter.render()\n\nplotter = pv.Plotter()\nplotter.add_slider_widget(\n    callback=update_threshold,\n    rng=[slider_min, slider_max],\n    value=iso_level,\n    title='Q iso‑level'\n)\n\nupdate_threshold(iso_level)  # initial draw\nplotter.show()\n","key":"z5BMy0NgHb"},{"type":"outputs","id":"u-l6NF-ZTtyNIs-lLt_zh","children":[],"key":"LtOE3ksz8T"}],"key":"QMp3o7I83D"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Optional: write mesh with Q array for ParaView\n# mesh.save('mesh_with_Q.vtp')\n# print('Saved mesh_with_Q.vtp')\n","key":"lWeLD9uY89"},{"type":"outputs","id":"i6Tbisq-g7Gt04w9N7C4B","children":[],"key":"GPWZEFEjNd"}],"key":"AfoeBuKDo1"}],"key":"nzhbRcK46M"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Sample TELEMAC-2D / GAIA steering file","url":"/gaia-example-explanations","group":"Implement"},"next":{"title":"What the Q-criterion is","url":"/q-criterion-1","group":"Implement"}}},"domain":"https://hydro-informatics.com"}
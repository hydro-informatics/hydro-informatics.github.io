n":1}},"key":"tmFKYDwbFK"}],"urlSource":"https://www.iws.uni-stuttgart.de/","key":"FUmSn72hmt"},{"type":"text","value":" und begeistert von programmatischen Ansätzen. Ihre Interessen sind auf hydromorphodynamische Modellierung und spatio-temporal Analysen von Flüssen, die sie mit fuzzy-basierten und datengetriebenen Methoden, Datenbankmanagement, Webentwicklung, Web-Schrott und Geospatial Python nutzt.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"Ty7Ux017u3"}],"key":"CspxUJ1HFc"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"link","url":"https://beatriznegreiros.com/","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Website","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"cmYmo9kNy5"}],"urlSource":"https://beatriznegreiros.com/","key":"Ul4jHW3vqu"},{"type":"text","value":"\n:\n::","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"lg6qMAqg08"}],"key":"rhBVMfrJFh"},{"type":"code","lang":"","value":"\n::\n:class: sd-m-auto\n\n<img src=\"../img/authors/sebastian.jpg\" />\n\n:\n\n:: Sebastian Schwindet\n\nSebastian leitet die hydromorphologische Modellierungsgruppe an der Universität Stuttgarts IWS](https://www.iws.uni-stuttgart.de/). Sein Hintergrund und seine Kernkompetenz sind Datenerfassungen in Kombination mit deterministisch-statistischen Rechenmethoden zur Ableitung datengesteuerter Erkenntnisse aus der hydraulischen Forschung. Sebastian promovierte an der Schweizer [Ecole Polytechnique fédérale de Lausanne (EPFL)](https://www.epfl.ch/), und ein Postdoc mit der [Pasternack group](https://pasternack.ucdavis.edu/) at [UC Davis](https://www.ucdavis.edu/).\n\n[Website](https://sebastian-schwindt.org)\n:\n::","position":{"start":{"line":44,"column":1},"end":{"line":59,"column":1}},"key":"Kgexqrlt1C"}],"key":"omTu0TBUrP"}],"key":"sV5c2grCvc"},"refe
:63,"column":1}},"key":"WvNUR7gJRi"},{"type":"inlineCode","value":".tex","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"Ud19QXBuoC"},{"type":"text","value":" Quelldatei in ein PDF-Dokument benötigt werden. Sowohl ein Editor (d.h. TeXstudio) als auch eine TeX-Distribution sind erforderlich, da der Editor allein den Code nicht kompilieren kann und die Distribution allein keine integrierte Umgebung zum Schreiben und Verwalten von LaTeX-Dokumenten bietet. Deshalb, bevor Sie den grafischen LaTeX Editor installieren, stellen Sie sicher, eine TeX Distribution zu installieren -- der LaTeX Editor wird versuchen, die installierte TeX Distribution während seiner eigenen Installation zu finden (nächst Schritt).","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"BnAzAWoWcp"}],"key":"d3RGpnsJCu"},{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"LaTeX package installation","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"bdqlmDNE0S"}],"key":"n2Zj7XWhbW"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"LaTeX packages are collections of additional commands, macros, and formatting instructions that extend the capabilities of the LaTeX system. Packages are typically introduced into a TeX document by including commands such as ","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"sjWSUBPkxj"},{"type":"inlineCode","value":"\\usepackage{...}","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"S2WhEslcmd"},{"type":"text","value":" in the preamble of a ","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"x71yUF1hAZ"},{"type":"inlineCode","value":".tex","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"Fw9YqtfWPd"},{"type":"text","value":" file. This allows authors to leverage specialized functionality, such as enhanced math notations, improved bibliography management, or particular typographic styles, without having to redefine or recode basic LaTeX commands. A TeX distribution comes bundled with a large set of commonly used packages and is often configured to retrieve more packages as needed. If a source file calls for a package that is not installed locally, the distribution can automatically download and install it from a central repository, ensuring that you have the resources required to compile the ","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"gXSCbMvXTn"},{"type":"inlineCode","value":".tex","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"XXaK83KbN0"},{"type":"text","value":" file into a PDF document without manually searching and installing additional files.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"bxip9YA2dr"}],"key":"q4n7y763MS"},{"type":"tabSet","children":[{"type":"tabItem","title":"Linux (Debian)","children":[{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Debian Linux-Benutzer können die Paketinstallation vereinfachen, indem sie alle verfügbaren TeX Live-Pakete mit ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"NW4cXo5ZYG"},{"type":"inlineCode","value":"sudo apt install texlive-full","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"VK34MkW2Dd"},{"type":"text","value":" installieren, obwohl dies 3-4 GB Speicherplatz einnimmt.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"trs04n2CxE"}],"key":"rNGc78H1ej"}],"key":"qOkcI045CO"},{"type":"tabItem","title":"Windows","children":[{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Windows-Benutzer werden empfohlen, MiKTeX mit einem Standard-Benutzerkonto anstatt Administrator-Privilegien zu installieren. Damit kann MiKTeX neue Pakete ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"d1Rx4t04yM"},{"type":"emphasis","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"on-the-fly","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"LfkbFSvPa3"}],"key":"DqyLTCbAFn"},{"type":"text","value":" herunterladen und installieren, ohne systemweite Berechtigungen wiederholt zu verlangen. Wenn MiKTeX von einem Administrator installiert wurde, würde jede zusätzliche Paket-Installation erhöhte Rechte erfordern und den Benutzer veranlassen, jedes Mal als Administrator zu authentifizieren, ein Prozess, der sowohl unannehmlich als auch möglicherweise weniger sicher ist. Stattdessen sorgt die Ausführung einer User-Level-Installation dafür, dass MiKTeX Pakete direkt in die aktuellen Benutzerverzeichnisse schreiben kann. Wählen Sie während der Installation die Option “Nein” aus und beantworten Sie “Nein”, wenn Sie Administratorrechte verwenden möchten. Nach dem Setup öffnen Sie das MiKTeX-Einstellungen-Panel und bestätigen Sie, dass die ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"ol7QxVcv28"},{"type":"emphasis","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"on-the-fly","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"qQG7LzfsTb"}],"key":"UKt4jgtdcH"},{"type":"text","value":"-Paketinstallation aktiviert ist.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"i0HegdCDOB"}],"key":"l19jZDDGUl"}],"key":"iJlU9QmCz6"}],"key":"TwltawkOxP"}],"class":"important","key":"nbD35KT3wq"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"link","url":"https://www.texstudio
":"text","value":"Contributor","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lLPZS5Fy3F"}],"key":"LuAP2Dtsly"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"This chapter was written and developed by ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"y0CkXvGVpD"},{"type":"link","url":"https://beatriznegreiros.com/","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Beatriz Negreiros","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"IV72Ea7IFU"}],"urlSource":"https://beatriznegreiros.com/","key":"Hewektw4e6"},{"type":"text","value":" ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"vctljUeiuA"},{"type":"image","url":"/de/build/beatriz-ab98aa05b68888c60985a0b92c552bf6.jpg","alt":"Beatriz Negreiros","width":50,"height":50,"key":"HU1paLAzj7","urlSource":"../img/authors/beatriz.jpg"}],"key":"u3g1pENilt"}],"class":"tip","key":"uTIQMRYh32"},{"type":"heading","depth":1,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Einleitung","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"NCTq26wshw"}],"label":"machinelearning","identifier":"machinelearning","html_id":"machinelearning","key":"weKZ63Ouk1"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Machine Learning (ML) ist wahrscheinlich eines der prominentesten Tools in der Datenwissenschaft, um die Wasserressourcenforschung voranzutreiben. ML-Modelle sind in der Lage, komplexe zugrunde liegende Zusammenhänge eines Systems zu erlernen und finden so ihre Anwendungen in verschiedenen Wasserressourcenthemen: von Flussökosystemen bis zur Wasserversorgung. Wir werden eine Vielzahl von Lernalgorithmen und -methoden abdecken, um ML-Modelle zu optimieren, damit sie sich auf ungesehene Daten verallgemeinern können, die im Prinzip überwachte und nicht überwachte Lerntechniken beinhalten.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Cc9INom0GV"}],"key":"Xft4wx5ayE"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Das Ziel des maschinellen Lernens","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"lH9kWnorgZ"}],"identifier":"das-ziel-des-maschinellen-lernens","label":"Das Ziel des maschinellen Lernens","html_id":"das-ziel-des-maschinellen-lernens","implicit":true,"key":"HiiDFrVH4W"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Machine Learning zielt darauf ab, komplexe Zusammenhänge aus Erfahrung (d.h. Daten) rechnerisch zu erlernen. ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"J0ALAl8BSG"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Computational learning","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"hGy1Tpga78"}],"key":"DTDj0ZXMhi"},{"type":"text","value":" ist ein Unterfeld künstlicher Intelligenz (KI), das sich auf die Entwicklung von Modellen konzentriert, die es Computern ermöglichen, Vorhersagen oder Entscheidungen zu lernen und zu treffen, ohne explizit programmiert zu werden. Es umfasst die Gestaltung und Umsetzung mathematischer und statistischer Modelle, die automatisch Daten analysieren, Muster identifizieren und fundierte Entscheidungen oder Vorhersagen basierend auf den beobachteten Daten treffen können. Diese Aufgabe kann beispielsweise die Vorhersage oder Modellierung komplexer Phänomene sein. Beachten Sie, dass die Vorhersage hier nicht nur auf die Zukunft, sondern auf ein nicht identifiziertes Ereignis verweist. So können wir z.B. vorhersagen, ob eine chemische Substanz bei einer Reihe von Umweltbedingungen in Wasser gelöst oder gelöst wird.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"KGgauyWN17"}],"key":"V9AJWEE1yM"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Im Gegensatz zum populären Denken sind ML-Algorithmen seit mehreren Jahrzehnten da. Sie wurden jedoch erst in den letzten zehn Jahren stark geachtet, als Einschränkungen in der Rechenleistung nicht mehr ein Hindernis für die Anwendung von ML ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"DBzs13rH2L"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"algorithmen","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Rq96ohZwIg"}],"key":"BitcWRJxRr"},{"type":"text","value":" für die Bereitstellung hilfreicher ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"e9Ud2bgIt5"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"ML-Modelle","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"ebokcLHPnb"}],"key":"SrELzlRTDB"},{"type":"text","value":" waren. Wir beziehen uns auf ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"CE1HLqbHnJ"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Algorithmen","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"rGGsE2o4dk"}],"key":"c4Wg24kdrE"},{"type":"text","value":" als Basiszeilen-Befehle, die ein Modell ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"rKZHH3aI4j"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"how aus Daten zu lernen","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"D8UfRCi3ja"}],"key":"GW9jOLgmsh"},{"type":"text","value":" anweisen, während ein ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"xMBiQN9t6n"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"ML-Modell","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"jmE9Sce4kD"}],"key":"DjUtjOzpKZ"},{"type":"text","value":" das Ergebnis (d.h. das gelernte Programm) des Lernens der Zielaufgabe aus der ausgewählten Regelreihe (","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"qJN4wtrsPK"},{"type":"emphasis","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"ML-Algorithmus","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"NclKlWbUZA"}],"key":"CxGtSpxKOU"},{"type":"text","value":") und Beispiele (d.h. Daten) ist.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"iBzsPLvsro"}],"key":"ThfGGJXQsS"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Arten des maschinellen Lernens","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"hXHiibW1eD"}],"identifier":"arten-des-maschinellen-lernens","label":"Arten des maschinellen Lernens","html_id":"arten-des-maschinellen-lernens","implicit":true,"key":"vmcMNp8cXC"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"In diesem Abschnitt beschäftigten wir uns hauptsächlich mit grundlegenden Elementen des überwachten Lernens, aber beachten Sie, dass es mehrere andere Arten von ML-Problemen gibt. Einige davon sind:","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ag7XsBwgvd"}],"key":"jogco8Mluv"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":24,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Unsupervised learning: Wir geben kein korrektes Verhalten an (d.h. Labels). Hier haben wir einige Beobachtungen, aber die Aufgabe selbst ist nicht klar definiert.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"LdcV0vAh6O"}],"key":"MeENelVPhP"}],"key":"jS7vbAjnPR"},{"type":"listItem","spread":true,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Semi-supervised learning: Wir können einige Teile unseres Modells mit einigen Etiketten angeben, aber andere Teile müssen ohne explizite Ziele gelernt werden. So können wir z.B. ununterbrochenes Lernen nutzen, um Cluster zu erhalten, die Funktionen zu einem überwachten Lernproblem definieren.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"Lwl99L6xIk"}],"key":"HTfgnOtbAW"}],"key":"OybOdQzEyk"},{"type":"listItem","spread":true,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Aktives Lernen: Der Algorithmus selbst kann nach weiteren, nützlichen Beispielen fragen. Lernen Sie zum Beispiel nur Beispiele auszuwählen, die für das Lernen tatsächlich benötigt werden.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"d5JTDNGqsC"}],"key":"qnkmCfHC9t"}],"key":"AQmVxFP8MY"},{"type":"listItem","spread":true,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Transfer-Lernen: Wenn eine Methode für ein individuelles Szenario trainiert wird und Sie es in einem anderen Szenario verwenden möchten. Dies bedeutet: Wie man von dem Gebrauch macht, was von A auf B gelernt wurde?","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"B0j7Z0XSH1"}],"key":"J0qVSd0qmp"}],"key":"Y8KyCFmh9r"},{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Verstärkungslernen: Das Modell ist ausgebildet, zu handeln, anstatt nur vorherzusagen, und der Algorithmus selbst nutzt Ergebnisse aus seinen experimentierten Handlungen als Feedback oder * Verstärkung*, um ein optimiertes Ergebnis von Handlungen zu erreichen (z.B. ein Roboterlernen zu gehen).","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"QOo0GxCVRZ"}],"key":"lsOt4IMYZF"}],"key":"EaETVIgg38"}],"key":"hoWBXfPN6l"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Der Unterschied zwischen maschinellem Lernen und Datenwissenschaft","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"VgsuyRUIAb"}],"label":"data-science","identifier":"data-science","html_id":"data-science","key":"SblcszIVL2"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Der konzeptionelle Unterschied zwischen Datenwissenschaft und maschinellem Lernen kann sich ähnlich dem Konzept von Rechtecken und Quadraten in der Geometrie vorstellen, wo die Datenwissenschaft mit ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"rsHTEIfmqv"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Rectangles","position":{"start":
ptually-uniform\")\nplt.show()\n\n# Diverging (positive/negative anomaly)\nZ_anom = np.sin(X) * np.cos(Y)\nplt.imshow(Z_anom, origin=\"lower\", cmap=cmocean.cm.balance, vmin=-1, vmax=1)\nplt.colorbar(label=\"Anomaly\")\nplt.title(\"Diverging around 0\")\nplt.show()\n\n# Cyclic (phase)\nZ_phase = np.angle(np.exp(1j*(X)))\nplt.imshow(Z_phase, origin=\"lower\", cmap=cmocean.cm.phase)\nplt.colorbar(label=\"Phase [rad]\")\nplt.title(\"Cyclic for wrap-around variables\")\nplt.show()","position":{"start":{"line":43,"column":1},"end":{"line":76,"column":1}},"key":"bUg8EztYpq"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Pour plus d’informations sur les cmocéaniques : ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"hsiIu3c97P"},{"type":"link","url":"https://matplotlib.org/cmocean/","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"matplotlib​.org​/cmocean","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"H9ddPq6e8A"}],"urlSource":"https://matplotlib.org/cmocean/","key":"BRexuua6sl"}],"key":"PvwZseyYgb"},{"type":"heading","depth":3,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Outils en cm de Fabio Crameri","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"wd1EZm6OzD"}],"identifier":"outils-en-cm-de-fabio-crameri","label":"Outils en cm de Fabio Crameri","html_id":"outils-en-cm-de-fabio-crameri","implicit":true,"key":"dvyax4n0ZH"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"link","url":"https://www.fabiocrameri.ch","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Fabio Crameri","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"ke
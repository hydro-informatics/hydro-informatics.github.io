"python","value":"import matplotlib.pyplot as plt\nimport numpy as np\nimport cmocean\n\n# Set a perceptually-uniform default\nplt.rcParams[\"image.cmap\"] = \"viridis\"\n\n# Example data\nx = np.linspace(-3, 3, 400)\ny = np.linspace(-3, 3, 400)\nX, Y = np.meshgrid(x, y)\nZ = np.hypot(X, Y)\n\n# Sequential (distance field)\nplt.imshow(Z, origin=\"lower\", cmap=cmocean.cm.thermal)\nplt.colorbar(label=\"Temperature-like quantity\")\nplt.title(\"Sequential, perceptually-uniform\")\nplt.show()\n\n# Diverging (positive/negative anomaly)\nZ_anom = np.sin(X) * np.cos(Y)\nplt.imshow(Z_anom, origin=\"lower\", cmap=cmocean.cm.balance, vmin=-1, vmax=1)\nplt.colorbar(label=\"Anomaly\")\nplt.title(\"Diverging around 0\")\nplt.show()\n\n# Cyclic (phase)\nZ_phase = np.angle(np.exp(1j*(X)))\nplt.imshow(Z_phase, origin=\"lower\", cmap=cmocean.cm.phase)\nplt.colorbar(label=\"Phase [rad]\")\nplt.title(\"Cyclic for wrap-around variables\")\nplt.show()","position":{"start":{"line":43,"column":1},"end":{"line":76,"column":1}},"key":"wA6yvJc3w0"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Pour plus d’informations sur les cmocéaniques : ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"LYk079bolP"},{"type":"link","url":"https://matplotlib.org/cmocean/","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"matplotlib​.org​/cmocean","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Y9hPLyLdTR"}],"urlSource":"https://matplotlib.org/cmocean/","key":"FfVD2GoXMp"}],"key":"QrAAChNgLP"},{"type":"heading","depth":3,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Outils en cm de Fabio Crameri","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"JsyJrwLsHq"}],"identifier":"outils-en-cm-de-fabio-crameri","label":"O